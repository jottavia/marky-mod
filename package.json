{
  "name": "marky-md-to-docx",
  "version": "1.0.0",
  "description": "Convert Markdown files to DOCX format using markdown-it",
  "main": "md-to-docx.js",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.cjs",
    "convert": "node md-to-docx.js",
    "serve": "npx http-server -S -C certs/cert.pem -K certs/key.pem -p 8443 ."
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "html-to-docx": "^1.1.2",
    "jsdom": "^29.1.1",
    "markdown-it": "^15.0.2"
  },
  "keywords": [
    "markdown",
    "docx",
    "converter"
  ],
  "license": "MIT"
}
