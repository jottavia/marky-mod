{
  "name": "marky-md-to-docx",
  "version": "1.0.0",
  "description": "Convert Markdown files to DOCX format using markdown-it",
  "main": "md-to-docx.js",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node scripts/test-sanitizer.cjs && node scripts/test-image-guard.cjs",
    "convert": "node md-to-docx.js",
    "serve": "npx http-server -S -C certs/cert.pem -K certs/key.pem -p 8443 ."
  },
  "dependencies": {
    "html-to-docx": "^1.8.0",
    "markdown-it": "^15.0.2"
  },
  "keywords": [
    "markdown",
    "docx",
    "converter"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jottavia/marky-mod.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/jottavia/marky-mod/issues"
  },
  "homepage": "https://github.com/jottavia/marky-mod#readme"
}
